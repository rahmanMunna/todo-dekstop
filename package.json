{
  "name": "todo-desktop",
  "productName": "Todo",
  "version": "0.3.0",
  "description": "Desktop todo app with overdue task reminders",
  "main": "./out/main/index.js",
  "author": "MD Habibur Rahman Munna",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "icon": "node scripts/make-icon.mjs",
    "dist": "electron-vite build && electron-builder --win --publish never",
    "release": "node scripts/release.mjs"
  },
  "build": {
    "appId": "com.rahmanmunna.todo",
    "productName": "Todo",
    "copyright": "Copyright © 2026 MD Habibur Rahman Munna",
    "publish": {
      "provider": "github",
      "owner": "rahmanMunna",
      "repo": "todo-dekstop",
      "releaseType": "release"
    },
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "out/**",
      "resources/**",
      "LICENSE"
    ],
    "asarUnpack": [
      "resources/**"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "license": "LICENSE"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.5"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
